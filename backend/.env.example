# ---------------------------------------------------------------------------
# TMV Driver PWA backend - LOCAL DEVELOPMENT
#
# Never commit a filled-in .env. See README.md for the architecture this maps to.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8090

# --- MongoDB (jobs, evidence, activity, driver accounts) ---
# Required. Atlas free tier is fine -- see README.md.
MONGODB_URI=
MONGODB_DB_NAME=tmv_pwa

# --- Google (Calendar sync + Gmail sending only -- Sheets and Drive were fully
#     removed; see README.md's Architecture section) ---
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Impersonated mailbox for Gmail (customer emails, password reset) and Calendar
# event creation via domain-wide delegation.
GOOGLE_WORKSPACE_IMPERSONATED_USER=

# --- Cloudinary (evidence photo storage, replaces Google Drive) ---
# Required for photo upload to actually work. Blank = the app runs fine, evidence
# upload just fails with a clear "not configured" error until this is set.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# --- Auth secrets (generate with: openssl rand -hex 32) ---
# Signs this app's own session cookies and password-reset links.
TMV_SIGNATURE_LINK_SECRET=
# Shared with TMV-Chat-bot -- it signs driver password-setup links from the admin
# dashboard's Add/Edit Driver flow, this app only verifies them. Must be the
# identical value in both projects' env files.
DRIVER_SETUP_LINK_SECRET=
# Shared password for this app's own /admin screens (driver roster + settings).
TMV_ADMIN_PASSWORD=

# This app's own public URL, for building absolute links in emails (password reset).
# Defaults to the production domain if unset.
APP_URL=https://chat.themanvan.co.uk

# --- Business rules (fallback values only -- each is overridable at runtime from the
#     /admin Settings screen without a redeploy; see README.md) ---
TMV_TIMEZONE=Europe/London
TMV_OVERTIME_RATE_PER_30_MINUTES=55
TMV_OVERTIME_GRACE_MINUTES=0
TMV_CONGESTION_CHARGE=18
TMV_TUNNEL_CHARGE=13
TMV_MAX_IMAGE_BYTES=10485760
TMV_NOTIFICATION_FROM_NAME=The Man Van
TMV_CREW_RATE_1_MAN=45
TMV_CREW_RATE_2_MAN=55
TMV_CREW_RATE_3_MAN=65
TMV_PACKING_RATE=95
TMV_PACKING_BILLING_UNIT=Per hour
TMV_CREW_BILLING_UNIT=Per 30 minutes

# --- Caching ---
TMV_CALENDAR_SYNC_TTL_MS=120000
